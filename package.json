{
  "name": "friend-daily",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && prisma generate && simple-git-hooks",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "spellcheck": "cspell ."
  },
  "dependencies": {
    "@github/textarea-autosize": "^0.3.3",
    "@prisma/client": "^5.16.2",
    "@unocss/reset": "^0.61.0",
    "@vueuse/core": "^10.11.0",
    "@vueuse/nuxt": "^10.11.0",
    "nuxt": "^3.12.2",
    "vue": "^3.4.29",
    "vue-i18n": "^9.13.1",
    "vue-router": "^4.3.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.21.1",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@iconify/json": "^2.2.223",
    "@unocss/eslint-plugin": "^0.61.0",
    "@unocss/nuxt": "^0.61.0",
    "@unocss/preset-uno": "^0.61.0",
    "@unocss/transformer-directives": "^0.61.0",
    "cspell": "^8.10.4",
    "eslint": "^9.4.0",
    "lint-staged": "^15.2.7",
    "prisma": "^5.15.1",
    "simple-git-hooks": "^2.11.1",
    "unocss": "^0.61.0",
    "vite-node": "^2.0.1"
  },
  "prisma": {
    "seed": "vite-node prisma/seed.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx commitlint --edit ${1}"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,vue}": [
      "eslint --fix",
      "cspell ."
    ]
  }
}
